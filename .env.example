# ── SweetShop Starter — ENV Template ──
# Copy: cp .env.example .env  → isi yang wajib, lalu npm run seed && npm run dev

# Database — local dev pakai SQLite, production Vercel pakai Turso LibSQL
# Local:
DATABASE_URL="file:./prisma/dev.db"
# Production (Turso) — buat di https://turso.tech :
# DATABASE_URL="libsql://your-db-yourname.turso.io"
# DATABASE_AUTH_TOKEN="eyJ..."

# Session — wajib ganti di production (min 32 chars). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-64-hex-random-min-32chars"

# Site — white-label (buyer ganti tanpa sentuh code)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SweetShop"
NEXT_PUBLIC_SITE_LOCALE="en"
NEXT_PUBLIC_SITE_CURRENCY="USD"

# Payment — adapter internasional
# mock = instant success, no gateway (default, COD-friendly, best for Gumroad demo)
# midtrans = Indonesia (QRIS/e-wallet/VA) — isi 3 key di bawah
# stripe = stub (buyer isi STRIPE_SECRET_KEY nanti, sekarang behave like mock)
PAYMENT_PROVIDER="mock"
PAYMENT_CURRENCY="USD"
COD_ENABLED="true"

# Midtrans — hanya jika PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"

# Stripe — hanya jika PAYMENT_PROVIDER=stripe (optional, stub sekarang)
# STRIPE_SECRET_KEY="sk_test_xxxxx"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
