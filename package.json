{
  "name": "sweetshop",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=18.17.0" },
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "seed": "npx tsx prisma/seed.ts",
